{
  "tool": "buck2",
  "command": [
    "buck2",
    "build",
    "//examples/portable/executor_runner:executor_runner",
    "--show-output"
  ],
  "prepare": [
    [
      "git",
      "submodule",
      "update",
      "--init",
      "--recursive"
    ],
    [
      "git",
      "-C",
      "third-party/prelude",
      "fetch",
      "--depth",
      "1",
      "origin",
      "cb8b34f660977893418853c0001b319cc9314798"
    ],
    [
      "git",
      "-C",
      "third-party/prelude",
      "checkout",
      "--detach",
      "cb8b34f660977893418853c0001b319cc9314798"
    ],
    [
      "python3",
      "-m",
      "pip",
      "install",
      "PyYAML==6.0.3"
    ],
    [
      "python3",
      "-m",
      "pip",
      "install",
      "--no-deps",
      "https://download-r2.pytorch.org/whl/cpu/torch-2.14.0%2Bcpu-cp311-cp311-manylinux_2_28_x86_64.whl#sha256=673dbf5c9bbadfffab7a386b6dd7a0c219f1408a328b7b4e86d0ae551cdafa42"
    ]
  ],
  "outputs": [
    "buck-out/**/executor_runner"
  ],
  "warm_hit_pattern": "cache hits: [1-9]|[1-9][0-9]* cache hits",
  "checks": [
    [
      "python3",
      "-c",
      "import glob,os; paths=[p for p in glob.glob(\"buck-out/**/executor_runner\",recursive=True) if os.path.isfile(p)]; assert paths and all(os.access(p,os.X_OK) and open(p,\"rb\").read(4)==b\"\\x7fELF\" for p in paths)"
    ]
  ]
}
