{
  "schema_version": 1,
  "id": "hugo-go",
  "kind": "benchmark",
  "adapter": "workflow",
  "workspace": "boringcache/benchmarks",
  "source": {
    "repository": "gohugoio/hugo",
    "pins": [
      {
        "path": "upstream",
        "revision": "6b3ba3a7e22ae2809605b8118aeed08b244f1955",
        "kind": "gitlink"
      }
    ]
  },
  "origin": {
    "repository": "boringcache/benchmark-hugo-go",
    "branch": "main",
    "revision": "d6186956df7f400627bb2566bd907431801b191c"
  },
  "execution": {
    "workflows": [
      {
        "path": ".github/workflows/native-rolling-benchmark.yml",
        "lane": "rolling",
        "inputs": {
          "case_id": "hugo-go"
        },
        "historical_workflow": "hugo-go-benchmark.yml"
      },
      {
        "path": ".github/workflows/native-fresh-benchmark.yml",
        "lane": "fresh",
        "inputs": {
          "case_id": "hugo-go"
        },
        "historical_workflow": "hugo-go-fresh-benchmark.yml"
      }
    ],
    "sync": "upstream-head",
    "sync_minute": 10,
    "native": {
      "action": ".github/actions/hugo-go-benchmark",
      "benchmark_id": "hugo-go",
      "rolling_inputs": {
        "go_version": "1.27.0"
      },
      "environment": {},
      "fresh_inputs": {
        "go_version": "1.27.0"
      }
    },
    "cache_tags": {
      "hugo-go-local": "{scope}"
    }
  },
  "reporting": {
    "entries": [
      "hugo-go"
    ],
    "publication": "reviewed"
  },
  "verification": [
    "Pinned upstream recipe and build success"
  ],
  "comparison": {
    "question": "How do build and cache reuse time and measured storage compare for the same pinned workload?",
    "providers": [
      "boringcache",
      "actions-cache"
    ],
    "timed_scope": "Timed build entrypoint plus measured cache restore/setup; upstream dependency installation remains included when the entrypoint performs it; unmeasured post-job save is reported separately",
    "primary_metric": "build_and_reuse_seconds",
    "storage": "provider-reported",
    "cache_scope": "Case-specific tags; fresh series use run and attempt identity; rolling series retain their declared cohort",
    "sample_count": 10
  }
}
