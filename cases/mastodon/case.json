{
  "schema_version": 1,
  "id": "mastodon",
  "kind": "benchmark",
  "adapter": "workflow",
  "workspace": "boringcache/benchmarks",
  "source": {
    "repository": "mastodon/mastodon",
    "pins": [
      {
        "path": "upstream",
        "revision": "4995c7ccbe03ce84795fff3b9bdc899f675ab08c",
        "kind": "gitlink"
      }
    ]
  },
  "origin": {
    "repository": "boringcache/benchmark-mastodon",
    "branch": "main",
    "revision": "af806ebb3a531c4196b47bfc655da5448db5ba54"
  },
  "execution": {
    "workflows": [
      {
        "path": ".github/workflows/native-fresh-benchmark.yml",
        "lane": "fresh",
        "inputs": {
          "case_id": "mastodon"
        },
        "historical_workflow": "mastodon-mastodon-fresh-benchmark.yml",
        "variants": [
          "server",
          "server-sccache",
          "streaming"
        ],
        "variant_input": "variant"
      },
      {
        "path": ".github/workflows/mastodon-mastodon-docker-benchmark.yml",
        "lane": "diagnostic",
        "inputs": {}
      },
      {
        "path": ".github/workflows/mastodon-mastodon-fresh-benchmark.yml",
        "lane": "diagnostic",
        "inputs": {}
      }
    ],
    "sync": "upstream-head",
    "sync_minute": 15,
    "cache_tags": {
      "mastodon-docker-local": "{scope}-docker",
      "mastodon-sccache-local": "{scope}-sccache"
    },
    "native": {
      "action": ".github/actions/mastodon-docker-benchmark",
      "benchmark_id": "mastodon",
      "fresh_inputs": {
        "workload": "server",
        "load_image": "true"
      },
      "rolling_inputs": {
        "workload": "server"
      },
      "variants": {
        "server": {},
        "server-sccache": {
          "benchmark_id": "mastodon-sccache",
          "fresh_inputs": {
            "docker_tool_cache": "true"
          },
          "rolling_inputs": {
            "docker_tool_cache": "true"
          },
          "provider_flags": {
            "actions-cache": {
              "docker_tool_cache": "false"
            }
          }
        },
        "streaming": {
          "benchmark_id": "mastodon-streaming",
          "fresh_inputs": {
            "workload": "streaming"
          },
          "rolling_inputs": {
            "workload": "streaming"
          }
        }
      }
    }
  },
  "reporting": {
    "entries": [
      "mastodon-docker",
      "mastodon-streaming"
    ],
    "publication": "reviewed"
  },
  "verification": [
    "Pinned upstream recipe and build success",
    "The freshly loaded output image exists in the local Docker image store"
  ],
  "comparison": {
    "question": "How do build and cache reuse time and measured storage compare for the same pinned workload?",
    "providers": [
      "boringcache",
      "actions-cache"
    ],
    "timed_scope": "Timed Docker build including image export and load, plus measured provider setup; output inspection is outside the timed build; provider post-job work is reported separately",
    "primary_metric": "build_and_reuse_seconds",
    "storage": "provider-reported",
    "cache_scope": "Case-specific tags; fresh series use run and attempt identity; rolling series retain their declared cohort",
    "sample_count": 10
  }
}
