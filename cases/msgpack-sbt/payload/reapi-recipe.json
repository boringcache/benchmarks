{
  "tool": "sbt",
  "command": [
    "./sbt",
    "--debug",
    "test"
  ],
  "prepare": [
    [
      "./sbt",
      "update"
    ]
  ],
  "outputs": [
    "target/out/jvm/u/msgpack-core/**/*.class",
    "target/out/jvm/u/jackson-dataformat-msgpack/**/*.class"
