{
  "tool": "moon",
  "command": [
    "moon",
    "run",
    "web:build"
  ],
  "prepare": [
    [
      "bun",
      "install",
      "--frozen-lockfile",
      "--cwd",
      "apps/web"
    ]
  ],
  "outputs": [
    "apps/web/dist/**/*"
  ],
  "warm_hit_pattern": "cached from remote|remote cache hit"
}
