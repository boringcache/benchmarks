{
  "schema_version": 1,
  "id": "posthog",
  "kind": "benchmark",
  "adapter": "workflow",
  "workspace": "boringcache/benchmarks",
  "source": {
    "repository": "PostHog/posthog",
    "pins": [
      {
        "path": "upstream",
        "revision": "ac5178dbde0dcdba308253d41bbd300befaaa516",
        "kind": "gitlink"
      }
    ]
  },
  "origin": {
    "repository": "boringcache/benchmark-posthog",
    "branch": "main",
    "revision": "19348dee23ef8b06302f95f179a524852518d373"
  },
  "execution": {
    "workflows": [
      {
        "path": ".github/workflows/native-fresh-benchmark.yml",
        "lane": "fresh",
        "inputs": {
          "case_id": "posthog"
        },
        "historical_workflow": "posthog-posthog-fresh-benchmark.yml",
        "variants": [
          "layers",
          "combined"
        ],
        "variant_input": "variant"
      },
      {
        "path": ".github/workflows/posthog-posthog-benchmark.yml",
        "lane": "diagnostic",
        "inputs": {}
      },
      {
        "path": ".github/workflows/native-rolling-benchmark.yml",
        "lane": "rolling",
        "inputs": {
          "case_id": "posthog"
        },
        "variants": [
          "layers",
          "combined"
        ],
        "variant_input": "variant"
      }
    ],
    "sync": "upstream-head",
    "sync_minute": 21,
    "cache_tags": {
      "posthog-docker-local": "{scope}-docker",
      "posthog-turbo-local": "{scope}-turbo"
    },
    "native": {
      "action": ".github/actions/posthog-docker-benchmark",
      "benchmark_id": "posthog",
      "fresh_inputs": {
        "platform": "linux/amd64",
        "load_image": "true"
      },
      "rolling_inputs": {
        "platform": "linux/amd64",
        "load_image": "true"
      },
      "variants": {
        "layers": {},
        "combined": {
          "benchmark_id": "posthog-toolcache-mountcache",
          "fresh_inputs": {
            "docker_tool_cache": "true",
            "docker_mount_cache": "true",
            "no_cache": "true"
          },
          "rolling_inputs": {
            "docker_tool_cache": "true",
            "docker_mount_cache": "true",
            "no_cache": "true"
          },
          "provider_flags": {
            "actions-cache": {
              "docker_tool_cache": "false",
              "docker_mount_cache": "false"
            }
          }
        }
      }
    }
  },
  "reporting": {
    "entries": [
      "posthog"
    ],
    "publication": "reviewed"
  },
  "verification": [
    "Pinned upstream recipe and build success",
    "The freshly loaded output image exists in the local Docker image store"
  ],
  "comparison": {
    "question": "How do build and cache reuse time and measured storage compare for the same pinned workload?",
    "providers": [
      "boringcache",
      "actions-cache"
    ],
    "timed_scope": "Timed Docker build including image export and load, plus measured provider setup; output inspection is outside the timed build; provider post-job work is reported separately",
    "primary_metric": "build_and_reuse_seconds",
    "storage": "provider-reported",
    "cache_scope": "Case-specific tags; fresh series use run and attempt identity; rolling series retain their declared cohort",
    "sample_count": 10
  }
}
