{
  "schema_version": 1,
  "id": "spring-ai",
  "kind": "benchmark",
  "adapter": "workflow",
  "workspace": "boringcache/benchmarks",
  "source": {
    "repository": "spring-projects/spring-ai",
    "pins": [
      {
        "path": "upstream",
        "revision": "3611ad078dd883e297f6fb40d540e856d66978f9",
        "kind": "gitlink"
      }
    ]
  },
  "origin": {
    "repository": "boringcache/benchmark-spring-ai",
    "branch": "main",
    "revision": "a7c6468d2f7c4d7d6f96692e52875c7b4c6b499b"
  },
  "execution": {
    "workflows": [
      {
        "path": ".github/workflows/native-rolling-benchmark.yml",
        "lane": "rolling",
        "inputs": {
          "case_id": "spring-ai",
          "cache_scope": "baseline-20261006"
        },
        "historical_workflow": "spring-ai-maven-benchmark.yml"
      },
      {
        "path": ".github/workflows/native-fresh-benchmark.yml",
        "lane": "fresh",
        "inputs": {
          "case_id": "spring-ai"
        },
        "historical_workflow": "spring-ai-maven-fresh-benchmark.yml"
      }
    ],
    "sync": "upstream-head",
    "sync_minute": 25,
    "native": {
      "action": ".github/actions/spring-maven-benchmark",
      "benchmark_id": "spring-ai-maven",
      "rolling_inputs": {
        "java_version": "17"
      },
      "environment": {},
      "fresh_inputs": {
        "java_version": "17"
      }
    },
    "cache_tags": {
      "spring-ai-maven-local": "{scope}-maven-remote"
    }
  },
  "reporting": {
    "entries": [
      "spring-ai-maven"
    ],
    "publication": "reviewed"
  },
  "verification": [
    "Pinned upstream recipe and build success"
  ],
  "comparison": {
    "question": "How do build and cache reuse time and measured storage compare for the same pinned workload?",
    "providers": [
      "boringcache",
      "actions-cache"
    ],
    "timed_scope": "Timed build entrypoint plus measured cache restore/setup; upstream dependency installation remains included when the entrypoint performs it; unmeasured cache publication is reported separately",
    "primary_metric": "build_and_reuse_seconds",
    "storage": "provider-reported",
    "cache_scope": "Case-specific tags; fresh series use run and attempt identity; rolling series retain their declared cohort",
    "sample_count": 10,
    "optional_providers": [
      "depot-actions-cache",
      "depot-cache"
    ]
  }
}
