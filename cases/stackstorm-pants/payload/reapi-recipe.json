{
  "tool": "pants",
  "command": [
    "pants",
    "--no-pantsd",
    "--stats-log",
    "--pytest-install-from-resolve=pants-plugins",
    "--pytest-requirements=['pytest==7.0.1']",
    "--no-python-infer-conftests",
    "test",
    "--report",
    "pants-plugins/pack_metadata/target_types_test.py"
  ],
  "prepare": [
    [
      "git",
      "submodule",
      "update",
      "--init",
      "--recursive"
    ],
    [
      "pants",
      "--version"
    ]
  ],
  "outputs": [
    "dist/test/reports/**/*.xml"
  ],
  "warm_hit_pattern": "remote_cache_requests_cached: [1-9]",
  "checks": [
    [
      "python3",
      "-c",
      "import glob,xml.etree.ElementTree as E; roots=[E.parse(p).getroot() for p in glob.glob(\"dist/test/reports/**/*.xml\",recursive=True)]; assert sum(len(list(r.iter(\"testcase\"))) for r in roots)>0; assert not any(list(r.iter(\"failure\"))+list(r.iter(\"error\")) for r in roots)"
    ]
  ]
}
